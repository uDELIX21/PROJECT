# SMS backend configuration — canonical list (design §13).
# Copy to .env for local dev. NEVER commit real values (REQ-SEC-02).

# --- environment ---
APP_NAME="Hope Star Academy SMS"
ENVIRONMENT=dev                 # dev | staging | prod
DEV_MODE=true                   # false in prod (hides docs/dev reset tokens)
TIMEZONE=Africa/Accra

# --- database ---
# dev:  DATABASE_URL=sqlite:///./dev.db
# prod: DATABASE_URL=postgresql+psycopg://sms_app:CHANGE_ME@db:5432/sms
DATABASE_URL=sqlite:///./dev.db
DATABASE_ECHO=false

# --- sessions / auth ---
SESSION_COOKIE_SECURE=false     # true behind HTTPS in prod
SESSION_IDLE_HOURS=12
SESSION_ABSOLUTE_DAYS=7
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# Argon2id work factors (lower in dev for speed; OWASP-recommended in prod)
ARGON_TIME_COST=3
ARGON_MEMORY_COST_KIB=65536
ARGON_PARALLELISM=4

RATELIMIT_ENABLED=true

# --- school bootstrap defaults (override later via settings UI) ---
DEFAULT_SCHOOL_NAME="Hope Star Academy (DEMO)"
ADMISSION_CODE_PREFIX=HSA
RECEIPT_PREFIX=HSA

# --- Phase 5+ integrations (names only — values stay in env, never DB) ---
# MTN_MOMO_PROVIDER=stub|hubtel|arkesel
# HUBTEL_CLIENT_ID=
# HUBTEL_CLIENT_SECRET=
# ARKESEL_API_KEY=
# SMS_PROVIDER=console|arkesel|hubtel

# --- Phase 10 ---
# S3_ENDPOINT=
# S3_BUCKET=sms-files
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# SENTRY_DSN=

# --- Phase 5: payment webhook signing (dev default used when unset) ---
SMS_WEBHOOK_SECRET=change-me-in-production
